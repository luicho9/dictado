#!/usr/bin/env python3
"""Hold-to-talk dictation for Hyprland, transcribed by Groq Whisper.

Usage: dictado start | stop | toggle
"""

import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from pathlib import Path

API_URL = "https://api.groq.com/openai/v1/audio/transcriptions"
MODEL = os.environ.get("DICTADO_MODEL", "whisper-large-v3-turbo")
LANGUAGE = os.environ.get("DICTADO_LANGUAGE", "es")
MIN_SECONDS = 0.4

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "dictado"
AUDIO = RUNTIME / "audio.wav"
PIDFILE = RUNTIME / "rec.pid"
STARTED = RUNTIME / "started"
ENV_FILE = Path.home() / ".config" / "dictado" / "env"


def notify(msg, urgency="low", timeout=1500):
    subprocess.run(
        ["notify-send", "-a", "dictado", "-u", urgency, "-t", str(timeout),
         "-h", "string:x-canonical-private-synchronous:dictado", "Dictado", msg],
        check=False,
    )


def load_key():
    key = os.environ.get("GROQ_API_KEY")
    if not key and ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            name, _, value = line.partition("=")
            if name.strip() == "GROQ_API_KEY":
                key = value.strip().strip("\"'")
    return key


def recording_pid():
    try:
        pid = int(PIDFILE.read_text())
        os.kill(pid, 0)
        return pid
    except (FileNotFoundError, ValueError, ProcessLookupError):
        return None


def start():
    if recording_pid():
        return
    RUNTIME.mkdir(parents=True, exist_ok=True)
    AUDIO.unlink(missing_ok=True)
    proc = subprocess.Popen(
        ["pw-record", "--rate", "16000", "--channels", "1", "--format", "s16", str(AUDIO)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
    PIDFILE.write_text(str(proc.pid))
    STARTED.write_text(str(time.time()))
    notify("🎙️ Escuchando...", timeout=60000)


def stop():
    pid = recording_pid()
    if not pid:
        return
    os.kill(pid, signal.SIGINT)
    for _ in range(50):
        try:
            os.kill(pid, 0)
            time.sleep(0.02)
        except ProcessLookupError:
            break
    PIDFILE.unlink(missing_ok=True)

    elapsed = time.time() - float(STARTED.read_text())
    if elapsed < MIN_SECONDS or not AUDIO.exists():
        notify("Muy corto, nada que transcribir")
        return

    key = load_key()
    if not key:
        notify(f"Falta GROQ_API_KEY en {ENV_FILE}", urgency="critical", timeout=5000)
        return

    notify("⏳ Transcribiendo...", timeout=10000)
    try:
        text = transcribe(AUDIO.read_bytes(), key)
    except Exception as e:  # noqa: BLE001 - surface any failure to the user
        notify(f"Error: {e}", urgency="critical", timeout=5000)
        return

    if not text:
        notify("No se detectó voz")
        return
    type_text(text)
    notify("✅ " + text[:80])


def transcribe(audio, key):
    boundary = uuid.uuid4().hex
    fields = {"model": MODEL, "language": LANGUAGE, "response_format": "json", "temperature": "0"}
    body = b""
    for name, value in fields.items():
        body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n"
                 f"{value}\r\n").encode()
    body += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"audio.wav\"\r\n"
             "Content-Type: audio/wav\r\n\r\n").encode() + audio + f"\r\n--{boundary}--\r\n".encode()

    req = urllib.request.Request(API_URL, data=body, method="POST", headers={
        "Authorization": f"Bearer {key}",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "User-Agent": "dictado/0.1",
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.load(resp).get("text", "").strip()
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"Groq {e.code}: {e.read().decode(errors='replace')[:200]}") from e


def type_text(text):
    if shutil.which("wtype"):
        subprocess.run(["wtype", "--", text], check=False)
    else:
        subprocess.run(["wl-copy"], input=text.encode(), check=False)
        notify("wtype no instalado: texto copiado al portapapeles", timeout=4000)


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "start":
        start()
    elif cmd == "stop":
        stop()
    elif cmd == "toggle":
        stop() if recording_pid() else start()
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
